{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenTwin Python: Debug Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "-x",
                "${file}"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "OpenTwin Python: Debug All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-s",
                "-x"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
