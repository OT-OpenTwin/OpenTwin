if [ -z "$BASH_VERSION" ]; then
    echo "otrc needs bash" >&2
    return 1
fi

#TODO(linux): ThirdParty python interpreter for linux
: "${OT_PYTHON:=python3}"

ot() {
    if [ -z "$OPENTWIN_DEV_ROOT" ]; then
        echo "Please set the following environment variables: OPENTWIN_DEV_ROOT" >&2
        return 1
    fi
    "$OT_PYTHON" -B "$OPENTWIN_DEV_ROOT/Scripts/Python/ot.py" "$@"
}

_ot_complete() {
    [ -n "$OPENTWIN_DEV_ROOT" ] || return 0
    mapfile -t COMPREPLY < <("$OT_PYTHON" -B "$OPENTWIN_DEV_ROOT/Scripts/Python/ot.py" --complete "$COMP_CWORD" "${COMP_WORDS[@]:1}" 2>/dev/null)
}

complete -F _ot_complete ot
